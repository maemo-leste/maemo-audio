# Compiler dependency files. Narrower than it looks: a bare *.d also
# swallows every *.conf.d directory, which is where the shipped config
# lives, and git then refuses to add anything new in one of those.
*.d
!*.conf.d/
module/*.o
tools/
mixer/*.o
mixer/*.so

